{
  "compilerOptions": {
    "target": "es2023",
    "module": "preserve",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client", "node"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* 本体の core/writingStats.ts・core/settingsSummary.ts（settingsMarkdown.ts）は型検査を通らないので、型だけ src/types の写しで見る（組み立ては本体のまま。引継ぎ書 161章・174章） */
    "paths": {
      "novel-ai-assistant/src/core/writingStats": ["./src/types/writingStatsCore.d.ts"],
      "novel-ai-assistant/src/core/settingsSummary": ["./src/types/settingsSummaryCore.d.ts"],
      "novel-ai-assistant/src/core/settingsMarkdown": ["./src/types/settingsMarkdownCore.d.ts"]
    }
  },
  "include": ["src", "test"]
}

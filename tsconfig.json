{
  "compilerOptions": {
    "target": "es2023",
    "module": "preserve",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client", "node"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* 本体の core/writingStats.ts は型検査を通らないので、型だけ src/types の写しで見る（組み立ては本体のまま。引継ぎ書 161章。settingsSummary の写しは 1.0.41 で外した。176章） */
    "paths": {
      "novel-ai-assistant/src/core/writingStats": ["./src/types/writingStatsCore.d.ts"]
    }
  },
  "include": ["src", "test"]
}

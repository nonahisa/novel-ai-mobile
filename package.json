{
  "name": "novel-ai-mobile",
  "private": true,
  "version": "0.0.0",
  "description": "統合小説執筆環境の Android 版（移植作業中）",
  "license": "MIT",
  "packageManager": "pnpm@10.34.9",
  "repository": {
    "type": "git",
    "url": "https://github.com/nonahisa/novel-ai-mobile.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync": "pnpm run build && cap sync android",
    "apk": "pnpm run sync && cd android && .\\gradlew.bat assembleDebug",
    "android": "pnpm run sync && cap run android",
    "sync:ios": "pnpm run build && cap sync ios",
    "ios": "pnpm run sync:ios && cap run ios",
    "ios:open": "pnpm run sync:ios && cap open ios",
    "devices": "adb devices -l"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "isomorphic-git": "^1.41.9"
  }
}
